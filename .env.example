DJANGO_SETTINGS_MODULE=django_crm.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LANGUAGE_CODE=ru-ru
DJANGO_TIME_ZONE=UTC
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite development.
# Set a full connection string for external PostgreSQL, for example:
# DATABASE_URL=postgresql://crm:crm@db:5432/crm
DATABASE_URL=

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432
